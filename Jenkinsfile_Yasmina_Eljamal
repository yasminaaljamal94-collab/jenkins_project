// Lab 10 - Jenkins CI/CD pipeline for a Python project
// Author: Yasmina Eljamal (yie08)
// Works on both Linux/macOS agents (sh) and Windows agents (bat).

def run(String unixCmd, String winCmd) {
    if (isUnix()) {
        sh unixCmd
    } else {
        bat winCmd
    }
}

pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
        DEPLOY_DIR  = 'deploy_target'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        run("python3 -m venv ${VIRTUAL_ENV}",
                            "python -m venv ${VIRTUAL_ENV}")
                    }
                    run(". ${VIRTUAL_ENV}/bin/activate && pip install -r requirements.txt",
                        "call ${VIRTUAL_ENV}\\Scripts\\activate.bat && pip install -r requirements.txt")
                }
            }
        }

        stage('Lint') {
            steps {
                script {
                    run(". ${VIRTUAL_ENV}/bin/activate && flake8 app.py",
                        "call ${VIRTUAL_ENV}\\Scripts\\activate.bat && flake8 app.py")
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    run(". ${VIRTUAL_ENV}/bin/activate && pytest -v",
                        "call ${VIRTUAL_ENV}\\Scripts\\activate.bat && pytest -v")
                }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    // Run the tests under coverage.py, print a report,
                    // and generate XML + HTML reports (fails below 80%).
                    run(". ${VIRTUAL_ENV}/bin/activate && coverage run -m pytest && coverage report && coverage xml && coverage html",
                        "call ${VIRTUAL_ENV}\\Scripts\\activate.bat && coverage run -m pytest && coverage report && coverage xml && coverage html")
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'coverage.xml, htmlcov/**', allowEmptyArchive: true
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    // Scan the source with bandit; the build fails on any
                    // medium- or high-severity finding (-ll).
                    run(". ${VIRTUAL_ENV}/bin/activate && bandit -r . -x ./venv,./tests -f txt -o bandit-report.txt --exit-zero && bandit -r . -x ./venv,./tests -ll",
                        "call ${VIRTUAL_ENV}\\Scripts\\activate.bat && bandit -r . -x ./venv,./tests -f txt -o bandit-report.txt --exit-zero && bandit -r . -x ./venv,./tests -ll")
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'bandit-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application..."
                    run(". ${VIRTUAL_ENV}/bin/activate && python deploy.py ${DEPLOY_DIR}",
                        "call ${VIRTUAL_ENV}\\Scripts\\activate.bat && python deploy.py ${DEPLOY_DIR}")
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished: all stages passed.'
        }
        failure {
            echo 'Pipeline failed.'
        }
        always {
            cleanWs()
        }
    }
}
